# Copiar a deploy/.env en la VM y cambiar todos los valores.
# Secretos largos: openssl rand -base64 48

# Dominio del backend (DuckDNS), sin https://
DOMINIO=memoria-atlantico.duckdns.org

# Frontend en Vercel: origen permitido por CORS y base de los enlaces de los QR
PUBLIC_WEB_URL=https://memoria-digital-atlantico.vercel.app

# PostgreSQL
POSTGRES_USER=mda
POSTGRES_PASSWORD=
POSTGRES_DB=memoria_digital

# Backend
LOG_LEVEL=info
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Asistente Miga: sin clave, el portal responde con su modo búsqueda
ANTHROPIC_API_KEY=
ASISTENTE_MODELO=claude-opus-5-5

# Contraseñas de las cuentas sembradas (admin@mda.local, personal@, revisora@, publico@)
SEED_ADMIN_PASSWORD=
SEED_PERSONAL_PASSWORD=
SEED_REVISORA_PASSWORD=
SEED_PUBLICO_PASSWORD=
