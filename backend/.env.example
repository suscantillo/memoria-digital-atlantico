# Copiar a .env (valores de desarrollo)
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# PostgreSQL
DATABASE_URL=postgresql://mda:mda_dev@localhost:5432/memoria_digital?schema=public

# JWT (mínimo 32 caracteres)
JWT_ACCESS_SECRET=cambiar-este-secreto-de-acceso-en-desarrollo
JWT_REFRESH_SECRET=cambiar-este-secreto-de-refresco-en-desarrollo
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS
PUBLIC_WEB_URL=http://localhost:5173

# Escaneos
STORAGE_DIR=./storage

# Semillas
SEED_ADMIN_PASSWORD=Admin.2026
SEED_PERSONAL_PASSWORD=Personal.2026
SEED_PUBLICO_PASSWORD=Publico.2026
